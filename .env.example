# HiringCat target
HIRINGCAT_URL=https://hiringcat.com
# For localhost E2E, first start HiringCat web/API with real dev env, then use:
# HIRINGCAT_URL=http://localhost:5173
HIRINGCAT_QA_URL=https://aamirmursleen.github.io/hiringcat-qa/

# Optional live app credentials. Leave empty to mark authenticated tasks as SKIP.
HIRINGCAT_TEST_EMAIL=
HIRINGCAT_TEST_PASSWORD=
HIRINGCAT_ORG_SLUG=
HIRINGCAT_JOB_SLUG=
HIRINGCAT_CUSTOM_DOMAIN=
HIRINGCAT_TEST_EMAIL_RECIPIENT=

# Browser/login mode.
# Set QA_HEADLESS=0 and HIRINGCAT_LOGIN_INTERACTIVE=1 when Clerk asks for an OTP/email code.
QA_HEADLESS=1
HIRINGCAT_LOGIN_INTERACTIVE=0
HIRINGCAT_LOGIN_CODE=
HIRINGCAT_LOGIN_WAIT_MS=180000
# Optional: reuse a previous run's saved session to avoid repeated OTP prompts.
HIRINGCAT_AUTH_STATE_PATH=

# Deep mode creates real QA job/candidate records and verifies them in dashboard/public pages.
DEEP_TEST_REPEAT=1
# Optional Playwright trace zips. Default off because traces are large; videos/storyboards are the normal proof.
QA_SAVE_TRACES=0

# Optional independent AI evidence review through H Company.
# Keep this private. Do not commit real keys from Portal-H.
HAI_API_KEY=
HAI_REVIEW_EVIDENCE=0
HAI_MODEL=holo3-1-35b-a3b

# Optional public run base. Defaults to the GitHub Pages path below.
PUBLIC_BASE_URL=https://aamirmursleen.github.io/hiringcat-qa

# Optional upload provider.
# local = links point to GitHub Pages run files after commit/push.
# moonpush = uploads files to MoonPush API; free links may expire and file limits apply.
VIDEO_UPLOAD_PROVIDER=local
MOONPUSH_UPLOAD_URL=https://www.moonpush.com/api/upload

# Optional WhatsApp delivery through WAQueen.
# Keep the key private. Do not commit it.
SEND_WHATSAPP=0
QA_REPORT_PHONE=+923294049067
WAQUEEN_API_KEY=
WAQUEEN_MESSAGES_URL=https://waqueen.com/api/v1/messages
